# Salin file ini menjadi .env lalu isi dengan nilai asli.
# Copy this file to .env and fill in real values.

# PostgreSQL connection string
# Dari dalam container, pakai host.docker.internal untuk menjangkau PostgreSQL di komputer host.
DATABASE_URL=postgresql://USERNAME:PASSWORD@host.docker.internal:5432/address_book

# Secret appended to every password before bcrypt hashing.
# Generate a long random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PASSWORD_PEPPER=change-me-to-a-long-random-string
